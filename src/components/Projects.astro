---
const githubProfileUrl = 'https://github.com/fabien7513';

const featuredProject = {
  eyebrow: 'Projet mis en avant',
  title: 'Jeu du Morpion',
  summary:
    'Un projet que j’aime particulièrement parce qu’il m’a permis de travailler la logique JavaScript, la gestion des états de jeu et l’interaction avec le DOM.',
  image: '/Morpion.png',
  alt: 'Capture du jeu du Morpion',
  badge: 'Logique JavaScript',
  type: 'Mini-jeu',
  technologies: 'JavaScript',
  focus: 'Logique de jeu, états et interactions DOM.',
  repository: githubProfileUrl,
  note:
    'J’y ai travaillé la logique de jeu, la mise à jour du DOM et une expérience simple mais claire.',
};

const projects = [
  {
    title: 'RogerVoice',
    badge: 'HTML / CSS',
    type: 'Site vitrine',
    description:
      'Création d’un site web de 4 pages en HTML/CSS inspiré de RogerVoice, avec une interface moderne, simple, lisible et responsive.',
    technologies: 'HTML, CSS',
    focus: 'Intégration multi-pages, hiérarchie visuelle et responsive.',
    image: '/RogerVoice.png',
    alt: 'Projet RogerVoice',
    repository: githubProfileUrl,
  },
  {
    title: 'HTML & CSS expliqué',
    badge: 'HTML / CSS',
    type: 'Site pédagogique',
    description:
      'Site éducatif de 4 pages conçu pour expliquer simplement le métier de développeur web et les bases du HTML, CSS et JavaScript.',
    technologies: 'HTML, CSS',
    focus: 'Pédagogie, structure éditoriale et lisibilité.',
    image: '/HTML.png',
    alt: 'Projet HTML et CSS expliqué',
    repository: githubProfileUrl,
  },
  {
    title: 'Jeu du Morpion',
    badge: 'JavaScript',
    type: 'Mini-jeu',
    description:
      'Développement d’un jeu de Morpion en JavaScript avec mode joueur contre joueur et joueur contre ordinateur.',
    technologies: 'JavaScript',
    focus: 'Logique de jeu, états et interactions DOM.',
    image: '/Morpion.png',
    alt: 'Jeu du Morpion',
    repository: githubProfileUrl,
  },
  {
    title: 'Quiz interactif',
    badge: 'JavaScript',
    type: 'Application front-end',
    description:
      'Application JavaScript avec questions aléatoires, validation immédiate des réponses et score final.',
    technologies: 'JavaScript',
    focus: 'Conditions, score, feedback utilisateur et navigation.',
    image: '/Quizz.png',
    alt: 'Quiz interactif',
    repository: githubProfileUrl,
  },
  {
    title: 'Calculatrice IMC',
    badge: 'JavaScript',
    type: 'Outil interactif',
    description:
      'Outil permettant de calculer l’IMC à partir du poids et de la taille, avec affichage du résultat et interprétation.',
    technologies: 'JavaScript',
    focus: 'Récupération de données utilisateur et affichage conditionnel.',
    image: '/IMC.png',
    alt: 'Calculatrice IMC',
    repository: githubProfileUrl,
  },
  {
    title: 'To-do list',
    badge: 'JavaScript',
    type: 'Application front-end',
    description:
      'Application permettant d’ajouter et supprimer des tâches simplement, avec manipulation du DOM et interactions utilisateur.',
    technologies: 'JavaScript',
    focus: 'Gestion d’actions utilisateur et mise à jour dynamique de l’interface.',
    image: '/ToDoList.png',
    alt: 'Application To-do list',
    repository: githubProfileUrl,
  },
  {
    title: 'Click le clown',
    badge: 'JavaScript',
    type: 'Mini-jeu',
    description:
      'Mini-jeu interactif en JavaScript basé sur le score, la rapidité et le déplacement aléatoire d’un élément à l’écran.',
    technologies: 'JavaScript',
    focus: 'Timing, score et animation d’un élément interactif.',
    image: '/Clickleclown.png',
    alt: 'Jeu Click le clown',
    repository: githubProfileUrl,
  },
];
---

<section id="projects">
  <div class="section-heading">
    <div>
      <p class="section-eyebrow">Projets</p>
      <h2>Quelques projets pour apprendre et progresser.</h2>
      <p class="section-text">
        Voici une sélection de projets réalisés durant ma formation, mes exercices
        pratiques et mes mises en situation de développement web. J’ai volontairement
        gardé une présentation simple pour laisser la place à l’essentiel.
      </p>
    </div>

    <a href={githubProfileUrl} target="_blank" rel="noopener noreferrer" class="button button-secondary">
      Voir mon GitHub
    </a>
  </div>

  <a
    href={featuredProject.repository}
    target="_blank"
    rel="noopener noreferrer"
    class="featured-project project-link-card js-tilt-card"
    data-tilt-strength="4"
    aria-label={`Voir le code du projet ${featuredProject.title} sur GitHub`}
  >
    <div class="featured-project-media">
      <img src={featuredProject.image} alt={featuredProject.alt} />
    </div>

    <div class="featured-project-content">
      <p class="featured-project-eyebrow">{featuredProject.eyebrow}</p>
      <div class="featured-project-header">
        <h3>{featuredProject.title}</h3>
        <span class="project-badge">{featuredProject.badge}</span>
      </div>
      <p>{featuredProject.summary}</p>
      <p class="featured-project-note">{featuredProject.note}</p>

      <span class="project-link-label">Voir le code sur GitHub</span>
    </div>
  </a>

  <div class="projects-grid">
    {projects.map((project) => (
      <a
        href={project.repository}
        target="_blank"
        rel="noopener noreferrer"
        class="project-card project-link-card js-tilt-card"
        data-tilt-strength="3"
        aria-label={`Voir le code du projet ${project.title} sur GitHub`}
      >
        <div class="project-visual">
          <img src={project.image} alt={project.alt} />
        </div>

        <div class="project-content">
          <div class="project-meta-line">
            <span class="project-badge">{project.badge}</span>
            <span class="project-type">{project.type}</span>
          </div>

          <div class="project-top">
            <h3>{project.title}</h3>
          </div>

          <p class="project-description">{project.description}</p>
          <p class="project-focus">{project.focus}</p>

          <span class="project-link-label">Voir le code sur GitHub</span>
        </div>
      </a>
    ))}
  </div>
</section>
