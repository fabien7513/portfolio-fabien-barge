  alt: 'Capture du jeu du Morpion',
  badge: 'Logique JavaScript',
  role: 'Conception de l’interface, logique de jeu, mode joueur contre joueur et joueur contre ordinateur.',
  results: ['Gestion des états de jeu', 'Interaction DOM immédiate', 'Mode IA simple'],
  highlights: [
    'Organisation du code pour gérer les tours, les coups gagnants et la réinitialisation.',
    'Manipulation du DOM pour refléter immédiatement chaque action du joueur.',
    'Travail sur la clarté visuelle et l’expérience utilisateur sur un mini-jeu complet.',
  ],
};

