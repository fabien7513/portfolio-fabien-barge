---
const skillGroups = [
  {
    title: 'Front-end',
    skills: ['HTML', 'CSS', 'JavaScript'],
    note: 'Intégration, responsive et interactivité.',
  },
  {
    title: 'Back-end',
    skills: ['Express', 'Twig'],
    note: 'Routes, structure du code et logique applicative.',
  },
  {
    title: 'Outils',
    skills: ['Git / GitHub', 'VS Code', 'Figma'],
    note: 'Versionnement, conception et organisation du travail.',
  },
];
---

<section id="skills">
  <div class="section-heading">
    <div>
      <p class="section-eyebrow">Compétences</p>
      <h2>Front-end, back-end et outils.</h2>
      <p class="section-text">
        Les technologies que j’utilise aujourd’hui.
      </p>
    </div>
  </div>

  <div class="skills-grid">
    {skillGroups.map((group, index) => (
      <article class="skill-card js-tilt-card" data-tilt-strength="5">
        <span class="skill-index">0{index + 1}</span>
        <h3>{group.title}</h3>

        <ul class="skill-list">
          {group.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>

        <p class="skill-note">{group.note}</p>
      </article>
    ))}
  </div>
</section>
